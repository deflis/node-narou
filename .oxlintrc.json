{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "browser": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ]
}
