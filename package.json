{
  "name": "narou",
  "version": "2.1.0",
  "description": "Narou API Wrapper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deflis/node-narou.git"
  },
  "license": "MIT",
  "author": "deflis <deflis@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "node": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "browser": {
        "import": "./dist/index.browser.mjs",
        "require": "./dist/index.browser.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/index.browser.d.mts",
      "import": "./dist/index.browser.mjs",
      "require": "./dist/index.browser.cjs",
      "default": "./dist/index.browser.mjs"
    }
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "src",
    "package.json",
    "pnpm-lock.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run check && pnpm run build:tsc",
    "build:tsc": "tsdown",
    "check": "pnpm run check:lint && pnpm run check:build && pnpm run test:unit",
    "check:lint": "oxlint --type-aware --deny-warnings src test",
    "check:build": "tsc --noEmit",
    "prepack": "pnpm run build",
    "format": "oxlint --type-aware --fix src test && oxfmt src test scripts *.ts *.json .oxlintrc.json .oxfmtrc.json tools/docs/package.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/narou.test.ts",
    "test:integration": "vitest run test/narou.test.ts",
    "docs": "pnpm run docs:clean && pnpm run docs:typedoc && pnpm run docs:json && pnpm run docs:llms",
    "docs:clean": "node -e \"require('node:fs').rmSync('docs', { recursive: true, force: true })\"",
    "docs:typedoc": "pnpm --dir tools/docs exec typedoc --tsconfig ../../tsconfig.json --out ../../docs ../../src/index.ts",
    "docs:json": "pnpm --dir tools/docs exec typedoc --tsconfig ../../tsconfig.json --json ../../docs/api.json ../../src/index.ts",
    "docs:llms": "node scripts/generate-llms-txt.js",
    "test:coverage": "vitest run --coverage.enabled true --exclude test/narou.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "msw": "^3.0.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "module": "dist/index.mjs",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.16.1",
      "onFail": "error"
    }
  }
}
